<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Privacy-first defaults. The module stays dormant until this Odoo is
         connected to Pantalytics (Settings, Odoo Self Learning, Connect to
         Pantalytics): the PostHog project key and host arrive in the signed
         entitlement, never from a data file. -->
    <record id="param_enabled" model="ir.config_parameter">
        <field name="key">pan_self_learning.enabled</field>
        <field name="value">True</field>
    </record>
    <!-- Session replay follows the entitlement (on once connected). Text, inputs and
         images are always masked. Flip on (disable) per instance if a customer opts out. -->
    <record id="param_disable_session_recording" model="ir.config_parameter">
        <field name="key">pan_self_learning.disable_session_recording</field>
        <field name="value">False</field>
    </record>
</odoo>
