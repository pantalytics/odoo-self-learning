<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Privacy-first defaults. The module stays dormant until this Odoo is
         connected to Pantalytics (Settings, Odoo Self Learning, Connect to
         Pantalytics): the PostHog project key and host arrive in the signed
         entitlement, never from a data file. -->
    <record id="param_enabled" model="ir.config_parameter">
        <field name="key">pan_self_learning.enabled</field>
        <field name="value">True</field>
    </record>
    <!-- Off: only INPUT fields are masked in recordings (always, in JS), so
         recordings stay useful. Flip on under Settings to also hide all visible
         text for a customer that requires maximum privacy. -->
    <record id="param_mask_all_text" model="ir.config_parameter">
        <field name="key">pan_self_learning.mask_all_text</field>
        <field name="value">False</field>
    </record>
    <!-- Session replay follows the entitlement (on once connected). Inputs are
         always masked. Flip on (disable) per instance if a customer opts out. -->
    <record id="param_disable_session_recording" model="ir.config_parameter">
        <field name="key">pan_self_learning.disable_session_recording</field>
        <field name="value">False</field>
    </record>
    <!-- Server errors (type and stack, never the text) go to the same project
         once connected and the entitlement allows it. Off here per instance. -->
    <record id="param_server_errors" model="ir.config_parameter">
        <field name="key">pan_self_learning.server_errors</field>
        <field name="value">True</field>
    </record>
</odoo>
