<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.self.learning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo Self Learning" string="Odoo Self Learning"
                     name="pan_self_learning" logo="/pan_self_learning/static/description/icon.png">
                    <block title="Pantalytics" name="pan_self_learning_account_block">
                        <setting id="pan_self_learning_account_setting"
                                 string="Pantalytics account"
                                 help="Odoo Self Learning reports to the Pantalytics workspace this Odoo instance is connected to. Nothing is sent until it is.">
                            <field name="pan_self_learning_link_status" invisible="1"/>
                            <div invisible="pan_self_learning_link_status != 'not_connected'" class="mt-2">
                                <button name="action_pan_self_learning_connect" type="object"
                                        string="Connect to Pantalytics" class="btn-primary"/>
                            </div>
                            <div invisible="pan_self_learning_link_status != 'pending'" class="mt-2">
                                <div>Approve the connection in the Pantalytics tab that just opened. The code there should read
                                    <field name="pan_self_learning_user_code" nolabel="1" readonly="1" class="fw-bold d-inline"/>.
                                </div>
                                <div class="mt-1">No tab?
                                    <field name="pan_self_learning_verify_url" widget="url" nolabel="1" readonly="1" class="d-inline"/>
                                </div>
                                <div class="mt-2">
                                    <button name="action_pan_self_learning_check" type="object"
                                            string="Check approval" class="btn-primary"/>
                                    <button name="action_pan_self_learning_disconnect" type="object"
                                            string="Cancel" class="btn-link"/>
                                </div>
                            </div>
                            <div invisible="pan_self_learning_link_status not in ('active', 'revoked', 'invalid')" class="mt-2">
                                <div invisible="pan_self_learning_link_status != 'active'">
                                    Connected<span invisible="not pan_self_learning_connected_by"> by <field name="pan_self_learning_connected_by" nolabel="1" readonly="1" class="d-inline"/></span>.
                                </div>
                                <div invisible="pan_self_learning_link_status == 'active'" class="text-warning">
                                    <field name="pan_self_learning_message" nolabel="1" readonly="1"/>
                                </div>
                                <div class="mt-2">
                                    <button name="action_pan_self_learning_check" type="object"
                                            string="Check now" class="btn-secondary"/>
                                    <button name="action_pan_self_learning_disconnect" type="object"
                                            string="Disconnect" class="btn-link text-danger"
                                            confirm="Disconnect this Odoo instance from Pantalytics? Odoo Self Learning stops reporting until it is connected again."/>
                                </div>
                            </div>
                            <div invisible="not pan_self_learning_last_error" class="mt-2 text-warning">
                                <field name="pan_self_learning_last_error" nolabel="1" readonly="1"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Privacy" name="pan_self_learning_settings_block">
                        <setting id="pan_self_learning_enabled_setting"
                                 string="Odoo Self Learning"
                                 help="Inject PostHog into the backend. Stays off until this Odoo instance is connected to Pantalytics.">
                            <field name="pan_self_learning_enabled"/>
                        </setting>
                        <setting id="pan_self_learning_replay_setting"
                                 string="Disable session replay"
                                 help="Session replay is on once connected, the most valuable signal for seeing where users get stuck. Input fields are always masked, so typed-in data never leaves the browser. Tick to turn replay off for this instance, for example a customer that opts out."
                                 invisible="not pan_self_learning_enabled">
                            <field name="pan_self_learning_disable_session_recording"/>
                        </setting>
                        <setting id="pan_self_learning_masktext_setting"
                                 string="Mask all visible text"
                                 help="Inputs are always masked regardless. Tick this to also hide all visible text (labels, values) in recordings: maximum privacy, but you mainly see layout and flow. Leave off for useful recordings."
                                 invisible="not pan_self_learning_enabled">
                            <field name="pan_self_learning_mask_all_text"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pan_self_learning_settings" model="ir.actions.act_window">
        <field name="name">Odoo Self Learning</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'pan_self_learning'}</field>
    </record>

    <menuitem id="menu_pan_self_learning_root"
              name="Odoo Self Learning"
              sequence="95"
              web_icon="pan_self_learning,static/description/icon.png"/>
    <menuitem id="menu_pan_self_learning_settings"
              name="Settings"
              parent="menu_pan_self_learning_root"
              action="action_pan_self_learning_settings"
              sequence="10"
              groups="base.group_system"/>
</odoo>
