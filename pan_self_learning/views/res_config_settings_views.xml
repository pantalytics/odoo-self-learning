<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings, Odoo Self Learning. A sensor, not an app: no menu of its
         own, one tab in Settings like Style Pro. Odoo's own settings markup
         (block, setting), so it looks like every other tab here: a section
         heading, a card of rows, one short line of help, one action.
         Nothing but the account row exists until it is connected. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.self.learning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo Self Learning" string="Odoo Self Learning"
                     name="pan_self_learning" groups="base.group_system"
                     logo="/pan_self_learning/static/description/icon.png">
                    <field name="pan_self_learning_state" invisible="1"/>

                    <block title="Pantalytics" name="pan_self_learning_account_block">
                        <setting id="pan_self_learning_account_setting" string="Account">
                            <div invisible="pan_self_learning_state != 'not_connected'">
                                <div class="text-muted">Not connected. Nothing is sent until you connect.</div>
                                <button name="action_pan_self_learning_connect" type="object"
                                        string="Connect Account" class="btn-primary mt-2"/>
                            </div>

                            <div invisible="pan_self_learning_state != 'pending'">
                                <div class="text-warning">Waiting for approval</div>
                                <div>Approve code
                                    <field name="pan_self_learning_user_code" nolabel="1" readonly="1" class="fw-bold d-inline"/>
                                    in the tab that opened. This page follows by itself.</div>
                                <widget name="pan_self_learning_wait"/>
                                <button name="action_pan_self_learning_disconnect" type="object"
                                        string="Cancel" class="btn-link px-0 mt-1"/>
                            </div>

                            <div invisible="pan_self_learning_state != 'connected'">
                                <span class="text-success">Connected</span>
                                <span invisible="not pan_self_learning_connected_by" class="text-muted ms-1">
                                    <field name="pan_self_learning_connected_by" nolabel="1" readonly="1" class="d-inline"/></span>
                            </div>

                            <div invisible="pan_self_learning_state != 'broken'">
                                <div class="text-danger">
                                    <field name="pan_self_learning_link_status" nolabel="1" readonly="1" class="d-inline"/>
                                </div>
                                <div invisible="not pan_self_learning_message" class="text-muted">
                                    <field name="pan_self_learning_message" nolabel="1" readonly="1" class="d-inline"/>
                                </div>
                                <button name="action_pan_self_learning_connect" type="object"
                                        string="Connect Account" class="btn-primary mt-2"/>
                            </div>

                            <div invisible="not pan_self_learning_last_error" class="mt-2 text-warning">
                                <field name="pan_self_learning_last_error" nolabel="1" readonly="1"/>
                            </div>
                        </setting>
                    </block>

                    <!-- Only once connected. Checkboxes, saved with Save. -->
                    <block title="Reporting" name="pan_self_learning_privacy_block"
                           invisible="pan_self_learning_state != 'connected'">
                        <setting id="pan_self_learning_replay_setting" string="Record Sessions"
                                 help="Typed text is always masked.">
                            <field name="pan_self_learning_session_replay"/>
                        </setting>
                        <setting id="pan_self_learning_masktext_setting" string="Mask All Text"
                                 help="Labels and values too.">
                            <field name="pan_self_learning_mask_all_text"/>
                        </setting>
                        <setting id="pan_self_learning_errors_setting" string="Report Server Errors"
                                 help="Error type and location only, never your data.">
                            <field name="pan_self_learning_server_errors"/>
                        </setting>
                    </block>

                    <!-- Destructive, last, confirmed. -->
                    <block title="Danger Zone" name="pan_self_learning_danger_block"
                           invisible="pan_self_learning_state != 'connected'">
                        <setting id="pan_self_learning_disconnect_setting" string="Disconnect"
                                 help="Reporting stops until you connect again.">
                            <button name="action_pan_self_learning_disconnect" type="object"
                                    string="Disconnect" class="btn-secondary mt-2"
                                    confirm="Disconnect this Odoo instance from Pantalytics? Reporting stops until you connect again."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
